{
  "identifier": "com.openclip.shortenlink",
  "name": {
    "en": "Shorten Link",
    "zh-Hans": "缩短网址",
    "zh-Hant": "縮短網址",
    "ja": "短縮リンク作成",
    "fr": "Raccourcir le lien"
  },
  "version": "1.2.3",
  "releaseNotes": "Accept scheme-less domains and treat them as HTTPS URLs.",
  "minOpenClipVersion": "1.3.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Shorten the selected URL using is.gd or v.gd, with optional automatic fallback.",
    "zh-Hans": "使用 is.gd 或 v.gd 缩短选中的网址，并可自动尝试备用服务。",
    "zh-Hant": "使用 is.gd 或 v.gd 縮短選取的網址，並可自動嘗試備用服務。",
    "ja": "is.gd または v.gd で URL を短縮し、必要に応じて自動で代替サービスを試します。",
    "fr": "Raccourcir l'URL sélectionnée avec is.gd ou v.gd, avec basculement automatique facultatif."
  },
  "options": [
    {
      "identifier": "domain",
      "label": {
        "en": "Preferred service",
        "zh-Hans": "首选服务",
        "zh-Hant": "偏好服務",
        "ja": "優先サービス",
        "fr": "Service préféré"
      },
      "type": "multiple",
      "default": "is.gd",
      "values": [
        "is.gd",
        "v.gd"
      ]
    },
    {
      "identifier": "automaticFallback",
      "label": {
        "en": "Try other service automatically",
        "zh-Hans": "自动尝试另一个服务",
        "zh-Hant": "自動嘗試另一個服務",
        "ja": "もう一方のサービスを自動で試す",
        "fr": "Essayer automatiquement l'autre service"
      },
      "type": "boolean",
      "default": "true"
    }
  ],
  "action": {
    "title": {
      "en": "Shorten Link",
      "zh-Hans": "缩短链接",
      "zh-Hant": "縮短網址",
      "ja": "リンク短縮",
      "fr": "Raccourcir"
    },
    "icon": "icon.svg",
    "type": "javascript",
    "async": true,
    "script": "main.js",
    "loading": true,
    "loadingMessage": {
      "en": "Shortening…",
      "zh-Hans": "正在缩短…",
      "zh-Hant": "正在縮短…",
      "ja": "短縮中…",
      "fr": "Raccourcissement…"
    },
    "requirements": {
      "regex": "(?i)^\\s*(?:https?://\\S+|[^@.\\s/?#]+(?:\\.[^@.\\s/?#]+)+(?::\\d+)?(?:[/?#]\\S*)?)\\s*$"
    },
    "output": "text"
  }
}
