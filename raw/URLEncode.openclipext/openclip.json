{
  "identifier": "com.openclip.urlencode",
  "name": {
    "en": "URL Encode",
    "zh-Hans": "URL 编解码",
    "zh-Hant": "URL 編解碼",
    "ja": "URL 変換",
    "fr": "Encodage URL"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.1.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Percent-encode or decode the selected text.",
    "zh-Hans": "对选中文本进行百分比编码或解码。",
    "zh-Hant": "對選中文本進行百分比編碼或解碼。",
    "ja": "選択したテキストをパーセントエンコードまたはデコードします。",
    "fr": "Encoder ou décoder le texte sélectionné avec des pourcentages."
  },
  "action": {
    "title": {
      "en": "URL Encode",
      "zh-Hans": "URL 编解码",
      "zh-Hant": "URL 編解碼",
      "ja": "URL 変換",
      "fr": "Encodage URL"
    },
    "icon": "icon.svg",
    "type": "group",
    "subActions": [
      {
        "id": "encode",
        "title": {
          "en": "URL Encode",
          "zh-Hans": "URL 编码",
          "zh-Hant": "URL 編碼",
          "ja": "URL エンコード",
          "fr": "Encoder URL"
        },
        "icon": "icon.svg",
        "type": "javascript",
        "script": "encode.js"
      },
      {
        "id": "decode",
        "title": {
          "en": "URL Decode",
          "zh-Hans": "URL 解码",
          "zh-Hant": "URL 解碼",
          "ja": "URL デコード",
          "fr": "Décoder URL"
        },
        "icon": "icon.svg",
        "type": "javascript",
        "script": "decode.js",
        "requirements": {
          "regex": "%[0-9A-Fa-f]{2}"
        }
      }
    ]
  }
}
