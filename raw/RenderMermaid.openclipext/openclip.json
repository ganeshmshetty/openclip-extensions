      "default": "svg",
      "values": [
        "svg",
        "png"
      ]
    },
    {
      "identifier": "theme",
      "label": {
        "en": "Theme",
        "zh-Hans": "主题",
        "zh-Hant": "主題",
        "fr": "Thème",
        "ja": "テーマ"
      },
