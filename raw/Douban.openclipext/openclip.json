{
  "identifier": "com.echohn.openclip.douban",
  "name": {
    "en": "Douban",
    "zh-Hans": "豆瓣"
  },
  "version": "1.0.1",
  "minOpenClipVersion": "1.0.0",
  "author": "echohn",
  "description": {
    "en": "Search Douban for books, movies, music and events from the selected text.",
    "zh-Hans": "用选中的文字在豆瓣搜索图书、电影、音乐和同城活动。"
  },
  "actions": [
    {
      "id": "douban",
      "title": {
        "en": "Douban",
        "zh-Hans": "豆瓣"
      },
      "icon": "Douban.svg",
      "type": "group",
      "subActions": [
        {
          "id": "book",
          "title": {
            "en": "Search Books",
            "zh-Hans": "搜索图书"
          },
          "icon": "Douban-book.svg",
          "type": "url",
          "url": "http://book.douban.com/subject_search?search_text={query}"
        },
        {
          "id": "movie",
          "title": {
            "en": "Search Movies",
            "zh-Hans": "搜索电影"
          },
          "icon": "Douban-movie.svg",
          "type": "url",
          "url": "http://movie.douban.com/subject_search?search_text={query}"
        },
        {
          "id": "music",
          "title": {
            "en": "Search Music",
            "zh-Hans": "搜索音乐"
          },
          "icon": "Douban-music.svg",
          "type": "url",
          "url": "http://music.douban.com/subject_search?search_text={query}"
        },
        {
          "id": "event",
          "title": {
            "en": "Search Events",
            "zh-Hans": "搜索同城活动"
          },
          "icon": "Douban-event.svg",
          "type": "url",
          "url": "http://www.douban.com/event/search?search_text={query}"
        },
        {
          "id": "all",
          "title": {
            "en": "Search Douban",
            "zh-Hans": "综合搜索"
          },
          "icon": "Douban.svg",
          "type": "url",
          "url": "http://www.douban.com/search?q={query}"
        }
      ]
    }
  ]
}
