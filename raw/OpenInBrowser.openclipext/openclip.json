{
  "identifier": "com.openclip.openinbrowser",
  "name": {
    "en": "Open in Browser",
    "zh-Hans": "在浏览器中打开",
    "zh-Hant": "在瀏覽器中打開",
    "ja": "ブラウザで開く",
    "fr": "Ouvrir dans le navigateur"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.1.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Open the selected link(s) in a specific browser.",
    "zh-Hans": "在指定的浏览器中打开选中的链接。",
    "zh-Hant": "在指定的瀏覽器中打開選取的連結。",
    "ja": "選択したリンクを指定したブラウザで開きます。",
    "fr": "Ouvrir le ou les liens sélectionnés dans un navigateur précis."
  },
  "action": {
    "id": "open",
    "title": {
      "en": "Open in Browser",
      "zh-Hans": "在浏览器中打开",
      "zh-Hant": "在瀏覽器中打開",
      "ja": "ブラウザで開く",
      "fr": "Ouvrir dans le navigateur"
    },
    "icon": "icon.svg",
    "type": "group",
    "keywords": [
      "browser",
      "open in",
      "open with",
      "link",
      "url"
    ],
    "requirements": {
      "regex": "https?://[^\\s/?#<>\"]+"
    },
    "subActions": [
      {
        "id": "safari",
        "title": {
          "en": "Safari",
          "zh-Hans": "Safari",
