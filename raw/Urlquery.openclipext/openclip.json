        "requirements": {
          "regex": "^\\s*(?![^/\\s]+\\.(?:js|mjs|cjs|ts|tsx|jsx|md|txt|png|jpe?g|gif|svg|webp|ico|css|html?|json|ya?ml|xml|csv|pdf|zip|gz|tar|py|rb|go|rs|java|swift|kt|sh|mp3|mp4|mov|exe|dmg|pkg|log|lock|toml|ini|env)[.,;:!?]*\\s*$)[<\"'(\\[]?(?:(?:(?:https?|hxxps?|ftp)(?::|\\[:\\])(?://|\\[//\\]|\\[/\\]/)?)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\}))+[a-z]{2,63}\\.?|(?:https?(?::|\\[:\\])//)?(?:\\d{1,3}(?:\\.|\\[\\.\\])){3}\\d{1,3})(?::\\d{1,5})?(?:[/?#][^\\s<>\"']*)?[>\"')\\]]?[.,;:!?]*\\s*$",
          "requiredOptions": ["apiKey"]
        },
        "options": [
          {
            "identifier": "apiKey",
            "label": {
              "en": "API key",
              "zh-Hans": "API 密钥",
              "zh-Hant": "API 金鑰",
              "fr": "Clé API",
              "ja": "API キー"
            },
            "type": "secret"
          },
          {
            "identifier": "access",
            "label": {
              "en": "Report visibility",
              "zh-Hans": "报告可见性",
              "zh-Hant": "報告可見性",
              "fr": "Visibilité du rapport",
              "ja": "レポートの公開範囲"
            },
            "type": "multiple",
            "default": "public",
            "values": ["public", "restricted", "private"]
          }
        ],
        "keywords": ["scan", "sandbox", "analyze", "report", "submit", "扫描", "analyser", "スキャン"]
      },
