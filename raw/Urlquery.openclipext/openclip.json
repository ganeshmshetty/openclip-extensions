          "requiredOptions": ["apiKey"]
        },
        "options": [
          {
            "identifier": "apiKey",
            "label": {
              "en": "API key",
              "zh-Hans": "API 密钥",
              "zh-Hant": "API 金鑰",
              "fr": "Clé API",
              "ja": "API キー"
            },
            "type": "secret"
          }
        ],
        "keywords": ["history", "recent", "reports", "previous", "past", "历史", "historique", "履歴"]
      },
      {
        "id": "open-website",
        "title": {
          "en": "Open on urlquery.net",
          "zh-Hans": "在 urlquery.net 打开",
          "zh-Hant": "在 urlquery.net 開啟",
          "fr": "Ouvrir sur urlquery.net",
          "ja": "urlquery.net で開く"
        },
        "icon": "globe",
        "type": "javascript",
        "script": "open-website.js",
        "requirements": {
          "regex": "^\\s*(?![^/\\s]+\\.(?:js|mjs|cjs|ts|tsx|jsx|md|txt|png|jpe?g|gif|svg|webp|ico|css|html?|json|ya?ml|xml|csv|pdf|zip|gz|tar|py|rb|go|rs|java|swift|kt|sh|mp3|mp4|mov|exe|dmg|pkg|log|lock|toml|ini|env)[.,;:!?]*\\s*$)[<\"'(\\[]?(?:(?:(?:https?|hxxps?|ftp)(?::|\\[:\\])(?://|\\[//\\]|\\[/\\]/)?)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\}))+[a-z]{2,63}\\.?|(?:https?(?::|\\[:\\])//)?(?:\\d{1,3}(?:\\.|\\[\\.\\])){3}\\d{1,3})(?::\\d{1,5})?(?:[/?#][^\\s<>\"']*)?[>\"')\\]]?[.,;:!?]*\\s*$"
        },
        "keywords": ["open", "website", "browser", "search", "urlquery.net", "打开", "ouvrir", "開く"]
      }
    ]
  }
}
