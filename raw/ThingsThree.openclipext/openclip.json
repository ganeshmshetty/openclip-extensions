  },
  "keywords": [
    "things",
    "things3",
    "todo",
    "task",
    "task manager",
    "inbox",
    "reminders",
    "待办",
    "待办事项",
    "任务",
    "タスク",
    "リマインダー",
    "tâche",
    "rappels"
  ],
  "options": [
    {
      "identifier": "when",
      "label": {
        "en": "Schedule for",
        "zh-Hans": "计划时间",
        "zh-Hant": "排程時間",
        "ja": "スケジュール",
        "fr": "Planifier pour"
      },
      "type": "multiple",
      "default": "inbox",
      "values": [
        "inbox",
        "today",
        "evening",
        "tomorrow",
        "someday"
      ]
    },
    {
      "identifier": "splitNotes",
      "label": {
        "en": "First line as title (rest as notes)",
        "zh-Hans": "首行作为标题（其余作为备注）",
        "zh-Hant": "首行作為標題（其餘作為備忘）",
        "ja": "1行目をタイトルにする（残りをメモにする）",
        "fr": "Première ligne comme titre (le reste en notes)"
      },
      "type": "boolean",
      "default": "false"
    },
    {
      "identifier": "list",
      "label": {
        "en": "Project or Area (optional)",
        "zh-Hans": "项目或区域（可选）",
        "zh-Hant": "專案或區域（選填）",
