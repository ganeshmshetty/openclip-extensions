        "fr": "Projet ou Domaine (facultatif)"
      },
      "type": "string",
      "default": ""
    },
    {
      "identifier": "tags",
      "label": {
        "en": "Tags (optional)",
        "zh-Hans": "标签（可选）",
        "zh-Hant": "標籤（選填）",
        "ja": "タグ（任意）",
        "fr": "Étiquettes (facultatif)"
      },
      "type": "string",
      "default": ""
    }
  ],
  "action": {
    "title": {
      "en": "Things 3",
      "zh-Hans": "Things 3",
      "zh-Hant": "Things 3",
      "ja": "Things 3",
      "fr": "Things 3"
