{
  "identifier": "io.appwrite.openclip.function-runner",
  "name": {
    "en": "Appwrite Function Runner",
    "zh-Hans": "Appwrite 函数运行器",
    "zh-Hant": "Appwrite 函式執行器",
    "fr": "Exécuteur de fonction Appwrite",
    "ja": "Appwrite 関数ランナー"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.1.0",
  "author": "Matej \"Meldiron\" Bačo",
  "description": {
    "en": "Send the selection to an Appwrite Function and use the reply.",
    "zh-Hans": "将选中的文本发送到 Appwrite 函数，并使用其返回结果。",
    "zh-Hant": "將選取的文字傳送到 Appwrite 函式，並使用其回傳結果。",
    "fr": "Envoyez la sélection à une fonction Appwrite et utilisez sa réponse.",
    "ja": "選択テキストを Appwrite 関数に送信し、その応答を利用します。"
  },
  "keywords": [
    "appwrite",
    "function",
    "serverless",
    "cloud",
    "api",
    "webhook"
  ],
  "options": [
    {
      "identifier": "endpoint",
      "label": {
        "en": "Endpoint",
        "zh-Hans": "端点",
        "zh-Hant": "端點",
        "fr": "Point de terminaison",
        "ja": "エンドポイント"
      },
      "type": "string",
      "default": "https://cloud.appwrite.io/v1"
    },
    {
      "identifier": "projectId",
      "label": {
        "en": "Project ID",
        "zh-Hans": "项目 ID",
        "zh-Hant": "專案 ID",
        "fr": "ID du projet",
        "ja": "プロジェクト ID"
      },
      "type": "string"
    },
    {
      "identifier": "functionId",
      "label": {
        "en": "Function ID",
        "zh-Hans": "函数 ID",
        "zh-Hant": "函式 ID",
        "fr": "ID de la fonction",
        "ja": "関数 ID"
      },
      "type": "string"
    },
    {
      "identifier": "apiKey",
      "label": {
        "en": "API key (optional)",
        "zh-Hans": "API 密钥（可选）",
        "zh-Hant": "API 金鑰（選填）",
        "fr": "Clé API (facultatif)",
        "ja": "API キー（任意）"
      },
      "type": "secret"
    },
    {
      "identifier": "payload",
      "label": {
        "en": "Payload format",
        "zh-Hans": "请求体格式",
        "zh-Hant": "請求內容格式",
        "fr": "Format de la charge utile",
        "ja": "ペイロード形式"
      },
      "type": "multiple",
      "default": "json",
      "values": [
        "json",
        "raw"
      ]
    }
  ],
  "action": {
    "id": "appwrite",
    "title": "Appwrite",
    "icon": "icon.svg",
    "type": "group",
    "subActions": [
      {
        "id": "execute",
        "title": {
          "en": "Execute Function",
          "zh-Hans": "执行函数",
          "zh-Hant": "執行函式",
          "fr": "Exécuter la fonction",
          "ja": "関数を実行"
        },
        "icon": "function",
        "type": "javascript",
        "script": "main.js",
        "async": true,
        "loading": true,
        "loadingMessage": "Executing function…",
        "requirements": {
          "requiredOptions": [
            "endpoint",
            "projectId",
            "functionId"
          ]
        },
        "keywords": [
          "execute",
          "run",
          "function",
          "appwrite",
          "serverless"
        ]
      }
    ]
  }
}
