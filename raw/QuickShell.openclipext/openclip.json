{
  "identifier": "com.openclip.quickshell",
  "name": {
    "en": "Quick Shell",
    "zh-Hans": "快速 Shell",
    "zh-Hant": "快速 Shell",
    "ja": "クイックShell",
    "fr": "Quick Shell"
  },
  "description": {
    "en": "Run shell commands silently in the background with instant status toasts and flexible output control.",
    "zh-Hans": "在后台静默运行 Shell 命令，具有即时状态提示和灵活的输出控制。",
    "zh-Hant": "在背景靜默執行 Shell 命令，具有即時狀態提示和靈活的輸出控制。",
    "ja": "バックグラウンドでシェルコマンドをサイレント実行し、結果をトースト通知や貼り付けで処理します。",
    "fr": "Exécutez des commandes shell silencieusement en arrière-plan avec notifications toast et contrôle de sortie."
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.1.0",
  "keywords": [
    "shell",
    "terminal",
    "command",
    "bash",
    "zsh",
    "run",
    "cli",
    "background"
  ],
  "options": [
    {
      "identifier": "output",
      "label": {
        "en": "Output Handling",
        "zh-Hans": "输出处理",
        "zh-Hant": "輸出處理",
        "ja": "出力の処理",
        "fr": "Gestion de la sortie"
      },
      "type": "multiple",
      "default": "Paste",
      "values": [
        "Paste",
        "Copy",
        "Toast",
        "Discard"
      ]
    },
    {
      "identifier": "prepend",
      "label": {
        "en": "Prepend Command",
        "zh-Hans": "前置命令",
        "zh-Hant": "前置命令",
        "ja": "先頭に追加するコマンド",
        "fr": "Préfixer la commande"
      },
      "type": "string",
      "default": ""
    },
    {
      "identifier": "append",
      "label": {
        "en": "Append Command",
        "zh-Hans": "追加命令",
        "zh-Hant": "追加命令",
        "ja": "末尾に追加するコマンド",
        "fr": "Suffixer la commande"
      },
      "type": "string",
      "default": ""
    }
  ],
  "action": {
    "id": "com.openclip.quickshell.run",
    "title": {
      "en": "Quick Shell",
      "zh-Hans": "快速 Shell",
      "zh-Hant": "快速 Shell",
      "ja": "クイックShell",
      "fr": "Quick Shell"
    },
    "icon": "icon.svg",
    "type": "shell",
    "script": "main.sh",
    "loading": true,
    "loadingMessage": {
      "en": "Running command…",
      "zh-Hans": "正在执行命令…",
      "zh-Hant": "正在執行命令…",
      "ja": "コマンドを実行中…",
      "fr": "Exécution de la commande…"
    },
    "requirements": {
      "requiresSelection": true
    }
  }
}
