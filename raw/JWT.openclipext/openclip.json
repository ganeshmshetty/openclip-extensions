{
  "identifier": "com.openclip.jwt",
  "name": {
    "en": "JWT",
    "zh-Hans": "JWT",
    "zh-Hant": "JWT",
    "ja": "JWT",
    "fr": "JWT"
  },
  "version": "1.1.0",
  "minOpenClipVersion": "1.1.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Decode JSON Web Tokens offline. Shows expiry at a glance.",
    "zh-Hans": "离线解码 JSON Web Token，一眼看清有效期。",
    "zh-Hant": "離線解碼 JSON Web Token，一眼看清有效期。",
    "fr": "Décodez des JSON Web Tokens hors ligne. L’expiration en un coup d’œil.",
    "ja": "JSON Web Token をオフラインでデコード。有効期限が一目でわかります。"
  },
  "keywords": [
    "jwt",
    "token",
    "json web token",
    "bearer",
    "oauth",
    "oidc",
    "claims",
    "decode",
    "expiry"
  ],
  "action": {
    "id": "jwt",
    "title": {
      "en": "JWT",
      "zh-Hans": "JWT",
      "zh-Hant": "JWT",
      "ja": "JWT",
      "fr": "JWT"
    },
    "icon": "icon.svg",
    "type": "group",
    "requirements": {
      "regex": "^\\s*(?:Authorization\\s*:\\s*)?(?:Bearer\\s+)?[\"'`]?ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*[\"'`,;]*\\s*$"
    },
    "subActions": [
      {
        "id": "decode-payload",
        "title": {
          "en": "Decode Payload",
          "zh-Hans": "解码载荷",
          "zh-Hant": "解碼載荷",
          "fr": "Décoder la charge utile",
          "ja": "ペイロードをデコード"
        },
        "icon": "curlybraces",
        "type": "javascript",
        "script": "decode-payload.js",
        "requirements": {
          "regex": "^\\s*(?:Authorization\\s*:\\s*)?(?:Bearer\\s+)?[\"'`]?ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*[\"'`,;]*\\s*$"
        },
        "keywords": [
          "decode",
          "payload",
          "claims",
          "json",
          "解码",
          "décoder",
          "デコード"
        ],
        "output": "text"
      },
      {
        "id": "decode-header",
        "title": {
          "en": "Decode Header",
          "zh-Hans": "解码头部",
          "zh-Hant": "解碼標頭",
          "fr": "Décoder l’en-tête",
          "ja": "ヘッダーをデコード"
        },
        "icon": "list.bullet.rectangle",
        "type": "javascript",
        "script": "decode-header.js",
        "requirements": {
          "regex": "^\\s*(?:Authorization\\s*:\\s*)?(?:Bearer\\s+)?[\"'`]?ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*[\"'`,;]*\\s*$"
        },
        "keywords": [
          "decode",
          "header",
          "alg",
          "kid",
          "jose",
          "头部",
          "en-tête",
          "ヘッダー"
        ],
        "output": "text"
      },
      {
        "id": "check-expiry",
        "title": {
          "en": "Check Expiry",
          "zh-Hans": "检查有效期",
          "zh-Hant": "檢查有效期",
          "fr": "Vérifier l’expiration",
          "ja": "有効期限を確認"
        },
        "icon": "clock.badge.exclamationmark",
        "type": "javascript",
        "script": "check-expiry.js",
        "requirements": {
          "regex": "^\\s*(?:Authorization\\s*:\\s*)?(?:Bearer\\s+)?[\"'`]?ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*[\"'`,;]*\\s*$"
        },
        "keywords": [
          "expiry",
          "expired",
          "exp",
          "valid",
          "ttl",
          "有效期",
          "expiration",
          "有効期限"
        ],
        "output": "none"
      }
    ]
  }
}
