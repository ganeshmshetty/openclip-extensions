{
  "identifier": "com.openclip.jwt",
  "name": {
    "en": "JWT",
    "zh-Hans": "JWT",
    "zh-Hant": "JWT",
    "ja": "JWT",
    "fr": "JWT"
  },
  "version": "2.0.0",
  "minOpenClipVersion": "1.7.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Decode JSON Web Tokens offline. Shows expiry at a glance.",
    "zh-Hans": "离线解码 JSON Web Token，一眼看清有效期。",
    "zh-Hant": "離線解碼 JSON Web Token，一眼看清有效期。",
    "fr": "Décodez des JSON Web Tokens hors ligne. L’expiration en un coup d’œil.",
    "ja": "JSON Web Token をオフラインでデコード。有効期限が一目でわかります。"
  },
  "keywords": [
    "jwt",
    "token",
    "json web token",
    "bearer",
    "oauth",
    "oidc",
    "claims",
    "decode",
    "expiry"
  ],
  "action": {
    "id": "decode",
    "title": {
      "en": "Decode JWT",
      "zh-Hans": "解码 JWT",
      "zh-Hant": "解碼 JWT",
      "ja": "JWT をデコード",
      "fr": "Décoder le JWT"
    },
    "icon": "icon.svg",
    "type": "javascript",
    "script": "decode.js",
    "requirements": {
      "regex": "^\\s*(?:Authorization\\s*:\\s*)?(?:Bearer\\s+)?[\"'`]?ey[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{2,}\\.[A-Za-z0-9_-]*[\"'`,;]*\\s*$"
    },
    "keywords": [
      "decode",
      "payload",
      "claims",
      "expiry",
      "exp",
      "解码",
      "有效期",
      "décoder",
      "expiration",
      "デコード",
      "有効期限"
    ],
    "output": "text",
    "result": "preview"
  }
}
