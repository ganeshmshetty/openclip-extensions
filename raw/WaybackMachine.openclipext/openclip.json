{
  "identifier": "com.openclip.waybackmachine",
  "name": "Wayback Machine",
  "version": "1.0.1",
  "minOpenClipVersion": "1.0.0",
  "author": "OpenClip Team",
  "description": "View historical web archives on the Wayback Machine.",
  "action": {
    "title": "Wayback Machine",
    "icon": "icon.svg",
    "type": "url",
    "url": "https://web.archive.org/web/*/{matched}",
    "requirements": {
      "regex": "(?:https?://|www\\.)\\S+"
    }
  }
}
