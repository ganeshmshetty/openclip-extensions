{
  "identifier": "com.openclip.jiraissue",
  "name": {
    "en": "Jira Issue",
    "zh-Hans": "Jira 事务",
    "zh-Hant": "Jira 問題",
    "fr": "Ticket Jira",
    "ja": "Jira 課題"
  },
  "description": {
    "en": "Create a Jira issue from the selected text. The first line becomes the summary and the rest the description.",
    "zh-Hans": "用所选文本创建 Jira 事务。第一行作为摘要，其余作为描述。",
    "zh-Hant": "用選取的文字建立 Jira 問題。第一行作為摘要，其餘作為描述。",
    "fr": "Créez un ticket Jira à partir du texte sélectionné. La première ligne devient le résumé, le reste la description.",
    "ja": "選択したテキストからJira課題を作成します。1行目が要約、残りが説明になります。"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.3.0",
  "author": "Ganesh M",
  "keywords": [
    "jira",
    "atlassian",
    "issue",
    "ticket",
    "bug",
    "task"
  ],
  "options": [
    {
      "identifier": "siteUrl",
      "label": {
        "en": "Site URL",
        "zh-Hans": "站点网址",
        "zh-Hant": "網站網址",
        "fr": "URL du site",
        "ja": "サイトURL"
      },
      "type": "string",
      "default": "https://your-domain.atlassian.net"
    },
    {
      "identifier": "email",
      "label": {
        "en": "Email",
        "zh-Hans": "电子邮件",
        "zh-Hant": "電子郵件",
        "fr": "E-mail",
        "ja": "メールアドレス"
      },
      "type": "string"
    },
    {
      "identifier": "apiToken",
      "label": {
        "en": "API Token",
        "zh-Hans": "API 令牌",
        "zh-Hant": "API 權杖",
        "fr": "Jeton API",
        "ja": "APIトークン"
      },
      "type": "secret"
    },
    {
      "identifier": "projectKey",
      "label": {
        "en": "Project Key",
        "zh-Hans": "项目键",
        "zh-Hant": "專案鍵",
        "fr": "Clé du projet",
        "ja": "プロジェクトキー"
      },
      "type": "string"
    },
    {
      "identifier": "issueType",
      "label": {
        "en": "Issue Type",
        "zh-Hans": "事务类型",
        "zh-Hant": "問題類型",
        "fr": "Type de ticket",
        "ja": "課題タイプ"
      },
      "type": "string",
      "default": "Task"
    }
  ],
  "actions": [
    {
      "id": "create",
      "title": {
        "en": "Create Jira Issue",
        "zh-Hans": "创建 Jira 事务",
        "zh-Hant": "建立 Jira 問題",
        "fr": "Créer un ticket Jira",
        "ja": "Jira課題を作成"
      },
      "icon": "icon.svg",
      "type": "javascript",
      "async": true,
      "script": "main.js",
      "loading": true,
      "loadingMessage": {
        "en": "Creating Jira issue…",
        "zh-Hans": "正在创建 Jira 事务…",
        "zh-Hant": "正在建立 Jira 問題…",
        "fr": "Création du ticket Jira…",
        "ja": "Jira課題を作成中…"
      },
      "output": "none",
      "keywords": [
        "jira",
        "issue",
        "create issue",
        "事务",
        "問題",
        "ticket",
        "課題"
      ]
    }
  ]
}
