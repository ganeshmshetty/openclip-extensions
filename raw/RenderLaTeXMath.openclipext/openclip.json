{
  "identifier": "com.openclip.render-latex-math",
  "name": {
    "en": "Render LaTeX Math",
    "zh-Hans": "渲染 LaTeX 数学公式",
    "zh-Hant": "渲染 LaTeX 數學公式",
    "fr": "Rendre les maths LaTeX",
    "ja": "LaTeX 数式を描画"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.7.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Render selected LaTeX math expressions offline with KaTeX. Math only, not full LaTeX documents.",
    "zh-Hans": "使用 KaTeX 离线渲染选中的 LaTeX 数学公式。仅支持数学公式，不支持完整的 LaTeX 文档。",
    "zh-Hant": "使用 KaTeX 離線渲染選取的 LaTeX 數學公式。僅支援數學公式，不支援完整的 LaTeX 文件。",
    "fr": "Rend hors ligne les maths LaTeX sélectionnées avec KaTeX. Maths uniquement, pas de documents complets.",
    "ja": "選択した LaTeX 数式を KaTeX でオフライン描画します。数式のみ対応で、LaTeX 文書全体には対応していません。"
  },
  "keywords": [
    "latex",
    "katex",
    "math",
    "equation",
    "formula",
    "tex"
  ],
  "options": [
    {
      "identifier": "size",
      "label": {
        "en": "Size",
        "zh-Hans": "大小",
        "zh-Hant": "大小",
        "fr": "Taille",
        "ja": "サイズ"
      },
      "type": "multiple",
      "default": "Medium",
      "values": [
        "Small",
        "Medium",
        "Large"
      ]
    },
    {
      "identifier": "theme",
      "label": {
        "en": "Theme",
        "zh-Hans": "主题",
        "zh-Hant": "主題",
        "fr": "Thème",
        "ja": "テーマ"
      },
      "type": "multiple",
      "default": "System",
      "values": [
        "System",
        "Light",
        "Dark"
      ]
    },
    {
      "identifier": "mode",
      "label": {
        "en": "Math without delimiters",
        "zh-Hans": "无定界符的公式",
        "zh-Hant": "無定界符的公式",
        "fr": "Maths sans délimiteurs",
        "ja": "区切り記号なしの数式"
      },
      "type": "multiple",
      "default": "Display",
      "values": [
        "Display",
        "Inline"
      ]
    },
    {
      "identifier": "macros",
      "label": {
        "en": "Custom macros (separate with ;), e.g. \\R = \\mathbb{R}",
        "zh-Hans": "自定义宏（用 ; 分隔），例如 \\R = \\mathbb{R}",
        "zh-Hant": "自訂巨集（以 ; 分隔），例如 \\R = \\mathbb{R}",
        "fr": "Macros personnalisées (séparées par ;), ex. \\R = \\mathbb{R}",
        "ja": "カスタムマクロ（; で区切る）例: \\R = \\mathbb{R}"
      },
      "type": "string",
      "default": ""
    }
  ],
  "action": {
    "title": {
      "en": "Render LaTeX Math",
      "zh-Hans": "渲染 LaTeX 数学公式",
      "zh-Hant": "渲染 LaTeX 數學公式",
      "fr": "Rendre les maths LaTeX",
      "ja": "LaTeX 数式を描画"
    },
    "icon": "icon.svg",
    "type": "javascript",
    "script": "dist/main.js",
    "output": "file",
    "result": "preview",
    "requirements": {
      "regex": "\\\\[a-zA-Z]{2,}\\s*[{_^]|\\\\(?:alpha|beta|gamma|delta|epsilon|theta|lambda|mu|pi|sigma|omega|infty|cdot|times|pm|leq|geq|neq|approx|to|sum|int|prod|sqrt|frac|partial|nabla|Delta|Sigma|Omega)(?![a-zA-Z])|[A-Za-z0-9)}]\\^[A-Za-z0-9{(\\\\]|_\\{|^\\s*(?:\\$\\$|\\\\\\[|\\\\\\()|^\\s*\\$[^$\\s][^$]*\\$\\s*$|(?:^|[\\s(=+\\-*,$])[A-Za-z]_(?:\\d+|[a-z])(?![A-Za-z0-9_])"
    }
  }
}
