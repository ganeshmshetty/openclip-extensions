        "icon": "arrow.up.left.and.arrow.down.right",
        "type": "shell",
        "script": "convert.sh",
        "output": "file",
        "requirements": {
          "regex": "\\.(png|jpe?g|gif|tiff?|heic|heif|webp|bmp|avif)\\s*$"
