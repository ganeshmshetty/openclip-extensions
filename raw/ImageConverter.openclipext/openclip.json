        },
        "icon": "photo",
        "type": "shell",
        "script": "convert.sh",
        "output": "file",
        "requirements": {
          "regex": "\\.(png|jpe?g|gif|tiff?|heic|heif|webp|bmp|avif)\\s*$"
        }
      },
      {
        "id": "tiff",
        "title": {
