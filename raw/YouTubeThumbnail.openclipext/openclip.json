{
  "identifier": "com.openclip.youtube-thumbnail",
  "name": {
    "en": "YouTube Thumbnail",
    "zh-Hans": "YouTube 缩略图",
    "zh-Hant": "YouTube 縮圖",
    "ja": "YouTube サムネイル",
    "fr": "Miniature YouTube"
  },
  "version": "1.0.0",
  "minOpenClipVersion": "1.7.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Download the full-resolution thumbnail image of a selected YouTube video link.",
    "zh-Hans": "下载选中 YouTube 视频链接的最高分辨率缩略图。",
    "zh-Hant": "下載選取 YouTube 影片連結的最高解析度縮圖。",
    "ja": "選択した YouTube 動画リンクの最高解像度のサムネイル画像をダウンロードします。",
    "fr": "Téléchargez la miniature en pleine résolution de la vidéo YouTube sélectionnée."
  },
  "keywords": [
    "youtube",
    "thumbnail",
    "video",
    "download",
    "image",
    "cover",
    "poster"
  ],
  "action": {
    "id": "thumb",
    "title": {
      "en": "Thumbnail",
      "zh-Hans": "缩略图",
      "zh-Hant": "縮圖",
      "ja": "サムネイル",
      "fr": "Miniature"
    },
    "icon": "icon.svg",
    "type": "shell",
    "script": "fetch.sh",
    "output": "file",
    "requirements": {
      "regex": "(youtu\\.be/|youtube\\.com/|[?&]v=[A-Za-z0-9_-]{11}|/shorts/|/embed/|/live/|^\\s*[A-Za-z0-9_-]{11}\\s*$)"
    }
  }
}
