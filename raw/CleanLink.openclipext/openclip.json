{
  "identifier": "com.openclip.cleanlink",
  "name": {
    "en": "Clean Link",
    "zh-Hans": "清理链接",
    "zh-Hant": "清理連結",
    "ja": "リンクを整理",
    "fr": "Nettoyer les liens"
  },
  "version": "1.1.0",
  "minOpenClipVersion": "1.1.0",
  "author": "OpenClip Team",
  "description": {
    "en": "Strip tracking parameters, affiliate tags, and marketing junk from URLs.",
    "zh-Hans": "从 URL 中移除跟踪参数、营销标签和推广垃圾。",
    "zh-Hant": "從 URL 中移除追蹤參數、行銷標籤和推廣垃圾。",
    "ja": "URLからトラッキングパラメータやアフィリエイトタグ、不要なクエリ文字列を削除します。",
    "fr": "Supprimez les paramètres de suivi, les balises marketing et d'affiliation des URL."
  },
  "keywords": [
    "clean link",
    "clean url",
    "url",
    "link",
    "tracking",
    "utm",
    "clearurl",
    "strip",
    "privacy",
    "remove tracking",
    "清理链接",
    "链接",
    "去参数"
  ],
  "action": {
    "title": {
      "en": "Clean Link",
      "zh-Hans": "清理链接",
      "zh-Hant": "清理連結",
      "ja": "リンクを整理",
      "fr": "Nettoyer le lien"
    },
    "icon": "icon.svg",
    "type": "javascript",
    "script": "main.js",
    "output": "text",
    "result": "paste-or-copy",
    "requirements": {
      "regex": "(?i)^\\s*(https?:\\/\\/)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&\\/\\/=]*)\\s*$"
    },
    "toast": {
      "message": "Link cleaned",
      "style": "success"
    }
  }
}
