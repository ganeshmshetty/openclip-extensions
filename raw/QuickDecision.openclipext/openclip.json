{
  "identifier": "com.openclip.quickdecision",
  "name": "Quick Decision",
  "version": "1.0.0",
  "minOpenClipVersion": "1.3.0",
  "author": "OpenClip",
  "description": "Instantly evaluate selected text against any question using AI.",
  "keywords": [
    "decision",
    "quick",
    "ai",
    "classifier",
    "safety",
    "evaluation",
    "typesafe",
    "jev",
    "local"
  ],
  "action": {
    "id": "evaluate",
    "title": "Quick Decision",
    "icon": "icon.svg",
    "type": "javascript",
    "async": true,
    "script": "main.js",
    "output": "text",
    "result": "preview",
    "options": [
      {
        "identifier": "question",
        "label": "Question",
        "type": "string",
        "default": "Is this content safe and trustworthy?"
      },
      {
        "identifier": "affirmativeLabel",
        "label": "Positive Label (Yes)",
        "type": "string",
        "default": "Safe"
      },
      {
        "identifier": "negativeLabel",
        "label": "Negative Label (No)",
        "type": "string",
        "default": "Suspicious"
      },
      {
        "identifier": "model",
        "label": "Model",
        "type": "string",
        "default": "jev-latest"
      },
      {
        "identifier": "apiKey",
        "label": "API Key",
        "type": "secret"
      },
      {
        "identifier": "endpoint",
        "label": "Endpoint URL",
        "type": "string",
        "default": "https://api.typesafe.ai/v1/systemone"
      }
    ],
    "requirements": {
      "requiresSelection": true,
      "requiredOptions": [
        "question"
      ]
    }
  }
}
