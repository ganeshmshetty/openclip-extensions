ObjC.import('Cocoa');
ObjC.import('WebKit');

// render.jxa <textFile> <outPng> <theme> <width>
// Renders the file's contents as a styled card via WebKit and writes a PNG.

function pump(condition, timeoutMs) {
  var deadline = Date.now() + (timeoutMs || 15000);
  while (!condition() && Date.now() < deadline) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }
  return condition();
}

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function buildHtml(text, theme, width) {
  var dark = theme !== 'light';
  var bg = dark ? '#161618' : '#ffffff';
  var fg = dark ? '#f5f5f7' : '#1d1d1f';
  var dot = dark ? '#3a3a3c' : '#d2d2d7';
  return '<!doctype html><html><head><meta charset="utf-8"><style>' +
    '*{box-sizing:border-box}' +
    'html,body{margin:0;padding:0}' +
    'body{width:' + width + 'px;background:' + bg + ';color:' + fg + ';' +
    'font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,monospace;font-size:14px;line-height:1.65}' +
    '.bar{display:flex;gap:6px;padding:14px 16px 0}' +
    '.dot{width:11px;height:11px;border-radius:50%;background:' + dot + '}' +
    '.card{padding:14px 26px 26px}' +
    'pre{margin:0;white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:14px;line-height:1.65}' +
    '</style></head><body><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>' +
    '<div class="card"><pre>' + escapeHtml(text) + '</pre></div></body></html>';
}

function run(argv) {
  var inPath = argv[0];
  var outPath = argv[1];
  var theme = argv[2] || 'dark';
  var width = parseFloat(argv[3]) || 480;

  var text = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(inPath, $.NSUTF8StringEncoding, null));
  var html = buildHtml(text, theme, width);

  var app = $.NSApplication.sharedApplication;
  app.setActivationPolicy($.NSApplicationActivationPolicyProhibited);

  var config = $.WKWebViewConfiguration.alloc.init;
  var webView = $.WKWebView.alloc.initWithFrameConfiguration($.NSMakeRect(0, 0, width, 200), config);
  webView.loadHTMLStringBaseURL(html, $.NSURL.fileURLWithPath('/'));

  pump(function () { return !webView.loading; }, 15000);

  var size = { w: width, h: 200 };
  var measured = false;
  webView.evaluateJavaScriptCompletionHandler(
    'JSON.stringify({w:Math.ceil(document.body.scrollWidth),h:Math.ceil(document.body.scrollHeight)})',
    function (result) {
      if (result) {
        try { size = JSON.parse(ObjC.unwrap(result)); } catch (e) {}
      }
      measured = true;
    }
  );
  pump(function () { return measured; }, 10000);

  webView.setFrame($.NSMakeRect(0, 0, size.w, size.h));
  pump(function () { return true; }, 200);

  var snapshotConfig = $.WKSnapshotConfiguration.alloc.init;
  snapshotConfig.rect = $.NSMakeRect(0, 0, size.w, size.h);
  snapshotConfig.snapshotWidth = $.NSNumber.numberWithDouble(size.w);

  var done = false;
  var image = null;
  webView.takeSnapshotWithConfigurationCompletionHandler(snapshotConfig, function (result) {
    if (result) { image = result; }
    done = true;
  });
  pump(function () { return done; }, 15000);

  if (!image) {
    return 'SNAPSHOT_FAILED';
  }

  var rep = $.NSBitmapImageRep.imageRepWithData(image.TIFFRepresentation);
  var png = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $.NSDictionary.dictionary);
  var wrote = png.writeToFileAtomically(outPath, true);
  return wrote ? 'OK' : 'WRITE_FAILED';
}
